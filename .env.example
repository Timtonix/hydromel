# ==============================================================================
# Configuration Dokploy / Production — Hydromel Merhzinsa
# ==============================================================================

# Base de données PostgreSQL (fournie par le service Postgres de Dokploy)
DATABASE_URL=ecto://postgres:MOT_DE_PASSE@hydromel-db:5432/hydromel_prod

# Clé secrète Phoenix (générer avec : mix phx.gen.secret)
SECRET_KEY_BASE=remplacer_par_une_cle_de_64_caracteres_minimum

# Nom de domaine public configuré dans Dokploy
PHX_HOST=hydromel.merhzinsa.fr
PORT=4000
PHX_SERVER=true

# Mot de passe partagé pour accéder à l'espace coopérative (/coop)
COOP_PASSWORD=votre_mot_de_passe_cooperative

# Expéditeur des e-mails récapitulatifs
MAILER_FROM_EMAIL=contact@merhzinsa.fr
MAILER_FROM_NAME="Coopérative Merhzinsa"

# Option A : Envoi d'e-mails par serveur SMTP (Brevo, Mailjet, OVH, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre_identifiant_smtp
SMTP_PASS=votre_mot_de_passe_smtp

# Option B : Envoi d'e-mails via l'API HTTP Brevo (alternative à SMTP)
# BREVO_API_KEY=xkeysib-...
